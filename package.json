{
  "name": "child-height-predictor",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "基于父母/亲属身高与儿童生长标准（WHO/中国）的子女成年身高预测（纯本地计算）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:data": "node scripts/generate-who-data.mjs && node scripts/generate-china-data.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
